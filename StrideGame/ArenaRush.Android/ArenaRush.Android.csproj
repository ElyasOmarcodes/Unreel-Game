<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArenaRush.Android</RootNamespace>
    <OutputPath>..\Bin\Android\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationId>com.elyasomar.arenarush</ApplicationId>
    <ApplicationTitle>Arena Rush</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <AndroidResgenNamespace>$(AssemblyName)</AndroidResgenNamespace>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)..\ArenaRush.Game\ArenaRush.Game.sdpkg</StrideCurrentPackagePath>
    <StridePlatform>Android</StridePlatform>
    <AndroidApplicationIcon>@mipmap/appicon</AndroidApplicationIcon>
    <!-- Standalone, sideloadable APK (no fast deployment, no app bundle), signed with the debug key. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!-- One CPU architecture per APK keeps the download small (pass -p:ArenaAbi=android-arm64 or android-x64). -->
    <ArenaAbi Condition="'$(ArenaAbi)' == ''">android-arm64</ArenaAbi>
    <RuntimeIdentifiers>$(ArenaAbi)</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ArenaRush.Game\ArenaRush.Game.csproj" />
  </ItemGroup>
</Project>
